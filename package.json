{
	"name": "pi-openai-decisions",
	"version": "0.1.0",
	"private": true,
	"description": "OpenAI Decisions as a native Pi classifier for codemode.",
	"keywords": [
		"classifier",
		"decisions",
		"openai",
		"pi-package"
	],
	"license": "MIT",
	"author": "Ryan Scott",
	"repository": {
		"type": "git",
		"url": "https://github.com/ryan-scott-dev/pi-openai-decisions.git"
	},
	"files": [
		"src/",
		"README.md",
		"AGENTS.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings .",
		"format:check": "oxfmt --check .",
		"check": "pnpm lint && pnpm format:check",
		"format": "oxfmt --write .",
		"smoke": "node --experimental-strip-types scripts/smoke.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.0.2",
		"@earendil-works/pi-coding-agent": "1.0.2",
		"@oxlint/plugins": "1.87.0",
		"@types/node": "22.19.15",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@10.33.1",
	"pnpm": {
		"overrides": {
			"@earendil-works/pi-ai": "1.0.2"
		}
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
